<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Fallback product when avr.service has no Linked Product (still billable on SO) -->
        <record id="product_tmpl_avr_generic_service" model="product.template">
            <field name="name">Workshop Service (Generic)</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="list_price">0.0</field>
            <field name="default_code">AVR-SVC-GEN</field>
        </record>
        <!-- Odoo auto-creates the default product.product variant; do not add a second one
             or UNIQUE(product_tmpl_id, combination_indices) will fail on upgrade. -->
    </data>
</odoo>
