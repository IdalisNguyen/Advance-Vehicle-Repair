<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_avr_booking" model="ir.sequence">
            <field name="name">AVR Booking</field>
            <field name="code">avr.booking</field>
            <field name="prefix">BN/VE-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_avr_job_card_inspection" model="ir.sequence">
            <field name="name">AVR Inspection Job Card</field>
            <field name="code">avr.job.card.inspection</field>
            <field name="prefix">INSP/JC-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_avr_job_card_repair" model="ir.sequence">
            <field name="name">AVR Repair Job Card</field>
            <field name="code">avr.job.card.repair</field>
            <field name="prefix">VEH/JC-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
