<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Booking Form ──────────────────────────────────────────────────────── -->
    <record id="view_avr_booking_form" model="ir.ui.view">
        <field name="name">avr.booking.form</field>
        <field name="model">avr.booking</field>
        <field name="arch" type="xml">
            <form string="Vehicle Booking">
                <header>
                    <button name="action_create_inspection_job_card" type="object"
                            string="Vehicle Inspection" class="btn-primary"
                            invisible="booking_type == 'repair_only'"/>
                    <button name="action_create_repair_job_card" type="object"
                            string="Create Repair" class="btn-secondary"/>
                    <button name="action_create_quotation" type="object" string="Create Quotation"
                            class="btn-secondary"
                            invisible="state not in ('new', 'quotation')"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'quotation'"/>
                    <button name="action_start_progress" type="object" string="Start Progress"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_complete" type="object" string="Mark Completed"
                            class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid"
                            class="btn-success"
                            invisible="state != 'completed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled', 'paid')"/>
                    <field name="state" widget="statusbar"  options="{'clickable': '1'}" readonly="0"
                           statusbar_visible="new,quotation,confirmed,in_progress,completed,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object"
                                class="oe_stat_button" icon="fa-usd"
                                invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Quotation / SO"/>
                        </button>
                        <button name="action_view_job_cards" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="job_card_count" widget="statinfo" string="Job Cards"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_source" widget="radio"/>
                        </group>
                        <group>
                            <field name="booking_type" widget="radio"/>
                        </group>
                    </group>
                    <group>
                        <group string="Vehicle Details">
                            <field name="customer_id"/>
                            <field name="vehicle_id"
                                   invisible="vehicle_source == 'fleet'"/>
                            <field name="fleet_vehicle_id"
                                   invisible="vehicle_source != 'fleet'"/>
                            <field name="brand"/>
                            <field name="model_name" string="Model"/>
                            <field name="fuel_type"/>
                            <field name="vin_number"/>
                            <field name="registration_no"/>
                            <field name="transmission_type" widget="radio"/>
                        </group>
                        <group string="Booking Details">
                            <field name="booking_date"/>
                            <field name="preferred_date"/>
                            <field name="preferred_time_slot"/>
                            <field name="booking_source"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="receptionist_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Customer Address Details">
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="street" placeholder="Street 1"/>
                            <field name="street2" placeholder="Street 2"/>
                        </group>
                        <group>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="zip_code"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <group string="Issue Description">
                        <field name="issue_description" nolabel="1"
                               placeholder="Describe the issue or required services..."/>
                    </group>
                    <group string="Internal Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Booking List ─────────────────────────────────────────────────────── -->
    <record id="view_avr_booking_list" model="ir.ui.view">
        <field name="name">avr.booking.list</field>
        <field name="model">avr.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings"
                  decoration-info="state == 'new'"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="booking_date"/>
                <field name="customer_id"/>
                <field name="brand"/>
                <field name="model_name"/>
                <field name="registration_no"/>
                <field name="fuel_type"/>
                <field name="booking_type"/>
                <field name="booking_source"/>
                <field name="receptionist_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state in ('quotation', 'confirmed')"
                       decoration-success="state in ('in_progress', 'completed', 'paid')"
                       decoration-danger="state == 'cancelled'"/>
                <field name="job_card_count"/>
            </list>
        </field>
    </record>

    <!-- ── Booking Kanban ───────────────────────────────────────────────────── -->
    <record id="view_avr_booking_kanban" model="ir.ui.view">
        <field name="name">avr.booking.kanban</field>
        <field name="model">avr.booking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="booking_type" class="o_kanban_mobile">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="brand"/>
                <field name="model_name"/>
                <field name="registration_no"/>
                <field name="booking_date"/>
                <field name="state"/>
                <field name="booking_type"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong><field name="name"/></strong>
                                <div><field name="customer_id"/></div>
                                <div class="text-muted">
                                    <field name="brand"/> / <field name="model_name"/>
                                </div>
                                <div><field name="registration_no"/></div>
                                <div><field name="booking_date" widget="date"/></div>
                                <div>
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {
                                               'new': 'info',
                                               'confirmed': 'warning',
                                               'completed': 'success',
                                               'cancelled': 'danger'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Booking Search ───────────────────────────────────────────────────── -->
    <record id="view_avr_booking_search" model="ir.ui.view">
        <field name="name">avr.booking.search</field>
        <field name="model">avr.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="brand"/>
                <field name="model_name"/>
                <field name="registration_no"/>
                <separator/>
                <filter string="New"         name="f_new"       domain="[('state','=','new')]"/>
                <filter string="Quotation"   name="f_quote"     domain="[('state','=','quotation')]"/>
                <filter string="Confirmed"   name="f_confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="In Progress" name="f_wip"       domain="[('state','=','in_progress')]"/>
                <filter string="Completed"   name="f_done"      domain="[('state','=','completed')]"/>
                <filter string="Paid"        name="f_paid"      domain="[('state','=','paid')]"/>
                <filter string="Cancelled"   name="f_cancel"    domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Website" name="f_web" domain="[('booking_source','=','website')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Customer"          name="gb_customer" context="{'group_by':'customer_id'}"/>
                    <filter string="Booking Source"    name="gb_source"   context="{'group_by':'booking_source'}"/>
                    <filter string="Brand"             name="gb_brand"    context="{'group_by':'brand'}"/>
                    <filter string="Model"             name="gb_model"    context="{'group_by':'model_name'}"/>
                    <filter string="Fuel Type"         name="gb_fuel"     context="{'group_by':'fuel_type'}"/>
                    <filter string="Transmission Type" name="gb_trans"    context="{'group_by':'transmission_type'}"/>
                    <filter string="Booking Type"      name="gb_type"     context="{'group_by':'booking_type'}"/>
                    <filter string="Status"            name="gb_state"    context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action ───────────────────────────────────────────────────────────── -->
    <record id="action_avr_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">avr.booking</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_avr_booking_search"/>
        <field name="context">{'search_default_f_new': 1}</field>
    </record>

</odoo>
