<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_avr_spare_part_form" model="ir.ui.view">
        <field name="name">avr.spare.part.form</field>
        <field name="model">avr.spare.part</field>
        <field name="arch" type="xml">
            <form string="Spare Part">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="part_number"/>
                            <field name="brand"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="category_id"/>
                            <field name="list_price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_avr_spare_part_list" model="ir.ui.view">
        <field name="name">avr.spare.part.list</field>
        <field name="model">avr.spare.part</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="part_number"/>
                <field name="brand"/>
                <field name="category_id"/>
                <field name="list_price"/>
            </list>
        </field>
    </record>

    <record id="action_avr_spare_part" model="ir.actions.act_window">
        <field name="name">Spare Parts</field>
        <field name="res_model">avr.spare.part</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
